ode-bg: #050A18; --code-ink: #BFD4FF; }

* { box-sizing: border-box; }

body { margin: 0px; background: var(--bg); color: var(--ink); font-family: =
Ysabeau, Optima, Candara, sans-serif; font-size: 16px; line-height: 1.6; }

.wrap { max-width: 920px; margin: 0px auto; padding: 64px 28px 120px; }

.masthead { display: flex; flex-direction: column; gap: 6px; margin-bottom:=
 64px; }

.masthead .eyebrow { font-family: Questrial, sans-serif; font-size: 12px; l=
etter-spacing: 0.14em; text-transform: uppercase; color: var(--sky); }

.masthead h1 { font-family: "Cormorant Garamond", serif; font-style: italic=
; font-weight: 600; font-size: 52px; line-height: 1.08; margin: 2px 0px 4px=
; text-wrap: balance; color: var(--ink); }

.masthead .sub { font-family: Questrial, sans-serif; font-size: 15px; color=
: var(--ink-soft); max-width: 60ch; }

.masthead .meta { margin-top: 18px; display: flex; gap: 18px; flex-wrap: wr=
ap; font-family: "IBM Plex Mono", monospace; font-size: 11.5px; color: var(=
--ink-soft); }

.masthead .meta b { color: var(--ink); font-weight: 500; }

section { margin-top: 64px; }

.section-head { display: flex; align-items: baseline; gap: 14px; margin-bot=
tom: 22px; padding-bottom: 10px; border-bottom: 1px solid var(--line); }

.section-head .num { font-family: "IBM Plex Mono", monospace; font-size: 12=
px; color: var(--sky); }

.section-head h2 { font-family: "Cormorant Garamond", serif; font-style: it=
alic; font-weight: 600; font-size: 28px; margin: 0px; color: var(--ink); }

.section-note { font-family: Questrial, sans-serif; font-size: 13.5px; colo=
r: var(--ink-soft); margin: -14px 0px 24px; max-width: 62ch; }

.palette { display: grid; grid-template-columns: repeat(6, 1fr); gap: 14px;=
 }

.swatch { border-radius: 10px; overflow: hidden; border: 1px solid var(--li=
ne); background: var(--surface); }

.swatch .chip { height: 88px; }

.swatch .info { padding: 10px 12px 14px; }

.swatch .name { font-family: Questrial, sans-serif; font-size: 13px; font-w=
eight: 400; color: var(--ink); }

.swatch .hex { font-family: "IBM Plex Mono", monospace; font-size: 11.5px; =
color: var(--ink-soft); margin-top: 2px; }

.swatch .role { font-family: Ysabeau, sans-serif; font-size: 12px; color: v=
ar(--ink-soft); margin-top: 6px; line-height: 1.4; }

@media (max-width: 820px) {
  .palette { grid-template-columns: repeat(3, 1fr); }
}

@media (max-width: 480px) {
  .palette { grid-template-columns: repeat(2, 1fr); }
}

.type-row { display: grid; grid-template-columns: 150px 1fr; gap: 20px; pad=
